{
  "compilerOptions": {
    "strict": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "module": "esnext",
    "target": "es2022",
    "baseUrl": ".",
    "paths": {
      "@blobe/*": ["../../packages/*/src"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
