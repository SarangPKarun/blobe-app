generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis()]
}

model User {
  id           String         @id @default(uuid())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  email        String?        @unique
  phone        String?        @unique
  username     String?        @unique
  posts        Post[]
  votes        Vote[]
  trustScore   TrustScore?
  notifications          Notification[]
  notificationPreference NotificationPreference?
  deviceTokens           DeviceToken[]
  sentPayments           Payment[]      @relation("SentPayments")
  receivedPayments       Payment[]      @relation("ReceivedPayments")
  stripeAccount          StripeAccount?
  campaigns              Campaign[]
  adBids                 AdBid[]
  messages     ChatMessage[]
  followers    Follows[]      @relation("Following")
  following    Follows[]      @relation("Follower")
}

model Follows {
  followerId  String
  followingId String
  follower    User     @relation("Follower", fields: [followerId], references: [id])
  following   User     @relation("Following", fields: [followingId], references: [id])
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Post {
  id        String                               @id @default(uuid())
  createdAt DateTime                             @default(now())
  updatedAt DateTime                             @updatedAt
  title     String
  content   String?
  authorId  String
  author    User                                 @relation(fields: [authorId], references: [id])
  location  Unsupported("geometry(Point,4326)")?
  frontText String?
  backText  String?
  mediaUrl  String?
  votes     Vote[]

  @@index([location], type: Gist)
}

model Banner {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  imageUrl  String
  linkUrl   String?
  isActive  Boolean   @default(true)
  activeFrom DateTime?
  activeTo   DateTime?
  ownerId    String?
}

model Vote {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])
  value     Int

  @@unique([userId, postId])
}

model TrustScore {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  score     Float    @default(0.0)
}

model Notification {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  content   String
  isRead    Boolean  @default(false)
  sourceId  String?
  actorId   String?

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
}

model NotificationPreference {
  id           String  @id @default(uuid())
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushEnabled  Boolean @default(true)
  emailEnabled Boolean @default(true)
  postCreated  Boolean @default(true)
  trustVote    Boolean @default(true)
  payment      Boolean @default(true)
}

model DeviceToken {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  active    Boolean  @default(true)

  @@index([userId])
}

model Payment {
  id                    String    @id @default(uuid())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  senderId              String
  recipientId           String
  sender                User      @relation("SentPayments",     fields: [senderId],    references: [id])
  recipient             User      @relation("ReceivedPayments", fields: [recipientId], references: [id])
  amount                Int
  currency              String    @default("usd")
  status                String    @default("pending")
  type                  String
  stripePaymentIntentId String?
  stripeTransferId      String?
  campaignId            String?
  campaign              Campaign? @relation(fields: [campaignId], references: [id])

  @@index([senderId])
  @@index([recipientId])
  @@index([status])
}

model StripeAccount {
  id               String   @id @default(uuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeAccountId  String   @unique
  chargesEnabled   Boolean  @default(false)
  payoutsEnabled   Boolean  @default(false)
  detailsSubmitted Boolean  @default(false)
}

model Campaign {
  id           String    @id @default(uuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  creatorId    String
  creator      User      @relation(fields: [creatorId], references: [id])
  title        String
  description  String?
  goalAmount   Int
  raisedAmount Int       @default(0)
  status       String    @default("active")
  dueDate      DateTime?
  payments     Payment[]

  @@index([creatorId])
  @@index([status])
}

model AdBid {
  id                    String   @id @default(uuid())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  userId                String
  user                  User     @relation(fields: [userId], references: [id])
  amount                Int
  startTime             DateTime
  endTime               DateTime
  imageUrl              String
  linkUrl               String?
  status                String   @default("pending")
  stripePaymentIntentId String?
  bannerId              String?

  @@index([userId])
  @@index([status])
  @@index([startTime, endTime])
}

model ChatMessage {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
}
