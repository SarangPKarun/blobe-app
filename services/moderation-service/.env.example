PORT=3007
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/blobe
KAFKA_BROKER=localhost:9092
JWT_SECRET=super-secret-default-key-for-dev

# Classifier thresholds
TEXT_HATE_THRESHOLD=0.7
TEXT_SPAM_THRESHOLD=0.8
NSFW_THRESHOLD=0.7
AUTO_APPROVE_CONFIDENCE=0.95

# NSFW backend: "openai" or "local"
NSFW_BACKEND=openai
# Set OPENAI_API_KEY in a local .env file (not committed)
OPENAI_API_KEY=

# HuggingFace model ID (weights baked into Docker image on build)
TEXT_MODEL_NAME=Hate-speech-CNERG/dehatebert-mono-english

# Hamming distance threshold for pHash CSAM matching (< this = match)
PHASH_DISTANCE_THRESHOLD=10
